# OpenAI
OPENAI_API_KEY=sk-...

# Web Search
TAVILY_API_KEY=tvly-...

# ChromaDB
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=omnimind_docs

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Router thresholds
RETRIEVAL_CONFIDENCE_THRESHOLD=0.75
LIVE_QUERY_KEYWORDS=today,latest,current,now,recent

# AWS
AWS_REGION=us-east-1
ECR_REGISTRY=

# Streamlit
BACKEND_URL=http://localhost:8080
